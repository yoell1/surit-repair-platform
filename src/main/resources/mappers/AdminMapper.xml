<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.surit.admin.model.mapper.AdminMapper">

	<select id="selectByAdminId" resultType="AdminDTO">
		SELECT ADMIN_ID, ADMIN_PWD, ADMIN_NAME
		  FROM ADMIN
		 WHERE ADMIN_ID = #{adminId}
	</select>

</mapper>